PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Base de datos
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/inventory?retryWrites=true&w=majority

# JWT
JWT_SECRET=tu_jwt_secret_muy_seguro_y_largo
JWT_REFRESH_SECRET=tu_jwt_refresh_secret_muy_seguro_y_largo

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=tu_token_de_redis

# Mailtrap
MAILTRAP_TOKEN=tu_mailtrap_token
MAILTRAP_ENDPOINT=https://send.api.mailtrap.io/

# Inteligencia Artificial
GEMINI_API_KEY=tu_gemini_api_key

# Webhooks / Workers
WORKER_API_KEY=tu_worker_api_key_secreto
SLA_TIMEOUT_MS=30000
